    "description": "App autorizada lee un objeto del bucket de datos, desde la IP permitida y por HTTPS",
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::mi-bucket-datos/reporte.csv",
    "context": {
      "aws:SourceIp": "192.0.2.10",
      "aws:SecureTransport": "true"
    },
    "expected": "Allow"
  },
  {
    "description": "Misma app intenta acceder a un bucket que NO esta en la policy (fuera de alcance)",
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::otro-bucket-cualquiera/archivo.txt",
    "context": {
      "aws:SourceIp": "192.0.2.10",
      "aws:SecureTransport": "true"
    },
    "expected": "Deny"
  },
  {
    "description": "Misma app intenta el mismo GetObject pero por HTTP en texto plano (sin TLS)",
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::mi-bucket-datos/reporte.csv",
    "context": {
      "aws:SourceIp": "192.0.2.10",
      "aws:SecureTransport": "false"
    },
    "expected": "Deny"
  },
