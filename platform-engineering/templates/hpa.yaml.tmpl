# Autoescalado generado automaticamente para el servicio: $service_name
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: $service_name
  labels:
    app: $service_name
    owner: $owner
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: $service_name
  minReplicas: 2
  maxReplicas: 6
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
