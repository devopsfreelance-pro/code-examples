# Multi-stage build sobre Alpine, tal como se describe en el post.
# Etapa de compilación: incluye gcc/musl-dev para instalar dependencias con
# extensiones en C (ej. MarkupSafe, dependencia de Flask).
FROM python:3.11-alpine AS builder

RUN apk add --no-cache \
    gcc \
    musl-dev \
    python3-dev

COPY app/requirements.txt .
RUN pip install --prefix=/install --no-cache-dir -r requirements.txt

# Etapa final: solo runtime, sin compiladores ni headers de desarrollo.
FROM python:3.11-alpine

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

COPY --from=builder /install /usr/local

COPY --chown=appuser:appuser app/app.py /app/app.py

WORKDIR /app
USER appuser

EXPOSE 5000
CMD ["python3", "app.py"]
